  "lifeWand": {
    "cls": "tools",
    "name": "生命魔杖",
    "text": "可以恢复100点生命值",
    "useItemEvent": [
      {
        "type": "comment",
        "text": "先恢复一个魔杖（因为使用道具必须消耗一个）"
      },
      {
        "type": "setValue",
        "name": "item:lifeWand",
        "operator": "+=",
        "value": "1"
      },
      {
        "type": "playSound",
        "name": "打开界面"
      },
      {
        "type": "input",
        "text": "请输入生命魔杖使用次数：(0-${item:lifeWand})"
      },
      {
        "type": "comment",
        "text": "【接受用户输入】弹窗输入的结果将会保存在“flag:input”中\n如果需要更多帮助，请查阅帮助文档"
      },
      {
        "type": "if",
        "condition": "flag:input<=item:lifeWand",
        "true": [
          {
